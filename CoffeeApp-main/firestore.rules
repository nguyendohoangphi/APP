rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role via Custom Claims
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Users can read their own doc.
    // they can UPDATE only if they do NOT touch 'role', 'isAdmin', 'points' (unless logic allows), etc.
    // For simplicity here, we allow updating basic fields, but we should strictly block 'role' or 'isAdmin' changes.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid != null; 
      
      // PREVENT Privilege Escalation: User cannot write 'role' or 'isAdmin' fields.
      // We allow 'rank' and 'point' updates because the client app likely handles loyalty logic.
      // (Ideally this should be server-side, but we preserve app functionality here).
      allow update: if request.auth.uid == userId 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']));
      
      // Allow users to delete their own account
      allow delete: if request.auth.uid == userId;
    }
    
    // Cart: Users can manage their own cart items.
    match /users/{userId}/cart/{document=**} {
      allow read, write, delete: if request.auth.uid == userId;
    }

    // Products, Categories, Tables, Ads: Public read, admin write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Users can create their own orders and read them. Admins can read all.
    match /orders/{orderId} {
      // Allow create if authenticated and email matches
      allow create: if request.auth.uid != null && request.resource.data.email == request.auth.token.email;
      allow read: if (request.auth.uid != null && resource.data.email == request.auth.token.email) || isAdmin();
      allow update, delete: if isAdmin(); // Only admins can modify/delete orders
    }

    // Coupons: Public read (or authenticated), Admin write
    match /Coupons/{couponId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Revenue: Admin read-only. NO client writes.
    // This enforces that revenue is only updated via backend/transaction logic.
    match /revenue/{date} {
      allow read: if isAdmin();
      allow write: if false; // IMPORTANT: Prevents any client-side modification
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
